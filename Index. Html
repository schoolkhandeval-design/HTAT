        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="nav-tabs">
        <button class="nav-btn active" onclick="switchMainTab('home')">🏠 Home Dashboard</button>
        <button class="nav-btn" onclick="switchMainTab('part1')">📚 Part - 1</button>
        <button class="nav-btn" onclick="switchMainTab('part2')">📖 Part - 2</button>
