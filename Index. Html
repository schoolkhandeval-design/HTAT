<meta name='viewport' content='width=device-width, initial-scale=1'/><!DOCTYPE html>
<html lang="gu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HTAT Master Preparation Portal 2026</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #e2e8f0;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --header-bg: #f1f5f9;
            --border-color: #cbd5e1;
            --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
            --accent-gradient: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            --success-gradient: linear-gradient(135deg, #10b981 0%, #059669 100%);
            --danger-gradient: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            --purple-gradient: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
            --teal-gradient: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
        }

        [data-theme="dark"] {
            --bg-main: #0f172a;
            --card-bg: #1e293b;
            --text-main: #f8fafc;
            --header-bg: #090d16;
            --border-color: #334155;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--bg-main);
            margin: 0;
            padding: 20px;
            color: var(--text-main);
            min-height: 100vh;
            transition: background 0.3s, color 0.3s;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            background: var(--card-bg);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            position: relative;
            border: 2px solid var(--border-color);
        }

        .header {
            display: grid;
            grid-template-columns: 120px 1fr 120px;
            align-items: center;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 20px;
            margin-bottom: 25px;
            gap: 15px;
        }

        @media (max-width: 768px) {
            .header {
                grid-template-columns: 1fr;
                text-align: center;
                justify-items: center;
            }
        }

        .brand-logo-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            background: var(--header-bg);
            padding: 10px;
            border-radius: 14px;
            border: 2px solid var(--border-color);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .brand-logo-box img {
            width: 48px;
            height: 48px;
            object-fit: cover;
            border-radius: 50%;
            border: 2px solid #f59e0b;
        }

        .htat-star-badge {
            background: var(--accent-gradient);
            color: white;
            font-weight: 900;
            font-size: 18px;
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
        }

        .header-title {
            text-align: center;
        }

        .header-title h2 {
            margin: 0 0 8px 0;
            font-size: 24px;
            font-weight: 900;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header-title h1 {
            margin: 0;
            font-size: 19px;
            font-weight: 800;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 0.5px;
        }

        .nav-tabs {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .nav-btn {
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 700;
            border: none;
            background: var(--header-bg);
            color: var(--text-main);
            cursor: pointer;
            border-radius: 12px;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s;
            border: 2px solid var(--border-color);
        }

        .nav-btn:hover {
            transform: translateY(-3px);
            border-color: #3b82f6;
            color: #2563eb;
        }

        .nav-btn.active {
            background: var(--primary-gradient);
            color: white;
            border-color: transparent;
            box-shadow: 0 0 20px rgba(79, 70, 229, 0.4);
        }

        .section-box { display: none; }
        .section-box.active { display: block; animation: fadeIn 0.4s ease-in-out; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .home-grid-top {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 25px;
            margin-bottom: 25px;
        }

        .home-grid-bottom {
            display: flex;
            justify-content: center;
        }

        .home-grid-bottom .digital-card {
            width: 100%;
            max-width: 550px;
        }

        .digital-card {
            background: var(--header-bg);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            position: relative;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            transition: all 0.4s;
            border: 2px solid var(--border-color);
            overflow: hidden;
        }

        .digital-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }

        .card-btn-3d {
            display: block;
            width: 100%;
            padding: 18px 20px;
            font-size: 17px;
            font-weight: 800;
            color: white;
            border: none;
            border-radius: 16px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 15px;
        }

        .card-btn-3d:hover {
            transform: translateY(-3px);
            filter: brightness(1.1);
        }

        .btn-part1 { background: var(--primary-gradient); }
        .btn-part2 { background: var(--accent-gradient); }
        .btn-part3 { background: var(--purple-gradient); }

        .digital-card h3 { font-size: 22px; color: var(--text-main); margin-bottom: 12px; font-weight: 800; }
        .digital-card p { color: #64748b; font-size: 15px; margin-bottom: 15px; line-height: 1.6; }

        .dropdown-card { background: var(--header-bg); border: 2px solid var(--border-color); border-radius: 14px; margin-bottom: 18px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.04); }
        .dropdown-header { padding: 20px 22px; background: var(--card-bg); cursor: pointer; font-weight: 700; font-size: 17px; display: flex; justify-content: space-between; align-items: center; transition: background 0.2s; color: var(--text-main); border-bottom: 2px solid var(--border-color); }
        .dropdown-header:hover { opacity: 0.9; }
        .dropdown-content { padding: 22px; display: none; background: var(--header-bg); }

        .action-btn { padding: 14px 28px; background: var(--primary-gradient); color: white; border: none; border-radius: 14px; cursor: pointer; font-weight: 800; font-size: 16px; margin: 6px; box-shadow: 0 8px 25px rgba(59, 130, 246, 0.35); transition: all 0.3s; text-transform: uppercase; }
        .action-btn:hover { transform: translateY(-3px); filter: brightness(1.1); }
        .study-btn { background: var(--success-gradient); box-shadow: 0 8px 25px rgba(16, 185, 129, 0.35); }
        .danger-btn { background: var(--danger-gradient); box-shadow: 0 8px 25px rgba(239, 68, 68, 0.35); }

        .exam-timer-bar {
            position: sticky;
            top: 10px;
            z-index: 100;
            background: var(--accent-gradient);
            color: white;
            padding: 12px 20px;
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 800;
            font-size: 18px;
            box-shadow: 0 10px 25px rgba(245, 158, 11, 0.4);
            margin-bottom: 20px;
        }

        .study-content-box { background: #f0fdf4; border-left: 6px solid #10b981; padding: 22px; border-radius: 12px; margin-bottom: 22px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        [data-theme="dark"] .study-content-box { background: #064e3b; }
        
        .question-card { margin-bottom: 22px; padding: 22px; border: 2px solid var(--border-color); border-radius: 14px; background: var(--header-bg); box-shadow: 0 4px 15px rgba(0,0,0,0.04); }
        .options label { display: block; margin: 10px 0; cursor: pointer; padding: 12px 16px; border-radius: 10px; border: 2px solid var(--border-color); font-size: 15px; font-weight: 500; transition: background 0.2s; background: var(--card-bg); color: var(--text-main); }
        .options label:hover { opacity: 0.8; }
        
        .correct-bg { background: #d1fae5 !important; border-color: #10b981 !important; border-left: 6px solid #10b981; color: #065f46 !important; }
        [data-theme="dark"] .correct-bg { background: #064e3b !important; color: #34d399 !important; }
        .incorrect-bg { background: #fee2e2 !important; border-color: #ef4444 !important; border-left: 6px solid #ef4444; color: #991b1b !important; }
        [data-theme="dark"] .incorrect-bg { background: #7f1d1d !important; color: #fca5a5 !important; }

        .admin-login-box { max-width: 400px; margin: 30px auto; background: var(--header-bg); padding: 30px; border-radius: 18px; border: 2px solid var(--border-color); box-shadow: 0 15px 35px rgba(0,0,0,0.1); text-align: center; }
        .admin-login-box input { width: 100%; padding: 12px; margin: 10px 0 18px 0; border-radius: 10px; border: 2px solid var(--border-color); font-size: 15px; box-sizing: border-box; background: var(--card-bg); color: var(--text-main); }
        
        .admin-panel { background: var(--header-bg); border: 3px dashed #f59e0b; padding: 25px; border-radius: 18px; margin-top: 15px; }
        textarea { width: 100%; height: 150px; padding: 14px; font-family: monospace; font-size: 14px; border: 2px solid var(--border-color); border-radius: 10px; box-sizing: border-box; background: var(--card-bg); color: var(--text-main); }

        .leaderboard-box { background: var(--header-bg); border: 2px solid var(--border-color); border-radius: 14px; padding: 22px; margin-top: 18px; }
        .score-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; border-bottom: 2px solid var(--border-color); font-size: 15px; font-weight: 600; color: var(--text-main); }

        .theme-toggle { position: absolute; top: 20px; right: 20px; background: var(--header-bg); border: 2px solid var(--border-color); color: var(--text-main); padding: 8px 14px; border-radius: 30px; cursor: pointer; font-weight: 700; font-size: 13px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }

        .footer {
            margin-top: 40px;
            text-align: center;
            border-top: 2px solid var(--border-color);
            padding-top: 20px;
            font-family: 'Poppins', sans-serif;
        }

        .footer-content {
            display: inline-block;
            background: var(--header-bg);
            color: var(--text-main);
            padding: 12px 30px;
            border-radius: 50px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            font-size: 15px;
            border: 1px solid var(--border-color);
        }

        .footer-content span {
            font-weight: 700;
            color: #3b82f6;
        }

        .audio-control-bar {
            background: var(--card-bg);
            border: 2px solid var(--border-color);
            padding: 15px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
    </style>
</head>
