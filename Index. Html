        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 18px;">
            <h2 style="font-weight: 800; font-size: 24px; margin: 0;">🏆 પ્રગતિ પત્રક અને સ્કોર ફિલ્ટર</h2>
            <div>
                <label style="font-weight: 700; margin-right: 8px;">ફિલ્ટર પસંદ કરો:</label>
                <select id="leaderboard-filter-select" onchange="renderLeaderboard()" style="padding: 10px 14px; border-radius: 10px; border: 2px solid var(--border-color); font-family: 'Poppins', sans-serif; font-size: 14px; background: var(--card-bg); color: var(--text-main);">
                    <option value="all">બધા જ સ્કોર (All Scores)</option>
                    <option value="part1">ભાગ - ૧ (સામાન્ય અભ્યાસ)</option>
                    <option value="part2">ભાગ - ૨ (શૈક્ષણિક કાયદાઓ)</option>
                    <option value="part3">ભાગ - ૩ (જૂના પેપરો)</option>
                    <option value="full_mock">૧૫૦ માર્ક્સ ફુલ મોક ટેસ્ટ</option>
                </select>
            </div>
        </div>

        <div class="leaderboard-box" id="leaderboard-content"></div>
        <button class="action-btn danger-btn" style="margin-top: 18px;" onclick="resetLeaderboard()">બધો સ્કોર રીસેટ કરો (Reset Progress)</button>
    </div>

    <!-- SECURE ADMIN PANEL -->
