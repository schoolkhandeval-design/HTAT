<script>
    function toggleTheme() {
        const body = document.body;
        const currentTheme = body.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        body.setAttribute('data-theme', newTheme);
        localStorage.setItem('htat_theme', newTheme);
    }

    window.addEventListener('DOMContentLoaded', () => {
        const savedTheme = localStorage.getItem('htat_theme') || 'light';
        document.body.setAttribute('data-theme', savedTheme);
        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = () => { window.speechSynthesis.getVoices(); };
        }
    });

    // =========================================================================
    // ADVANCED TTS ENGINE (WAKE-LOCK + CONTINUOUS RESUME)
    // =========================================================================
    let isAutoReading = false;
    let wakeLock = null;
    let speechKeepAliveTimer = null;
    let currentQuestionsList = [];
    let currentQIndex = 0;
    const silentKeeper = document.getElementById('htat-silent-keeper');

    async function requestWakeLock() {
        try {
            if ('wakeLock' in navigator) {
                wakeLock = await navigator.wakeLock.request('screen');
                wakeLock.addEventListener('release', () => {
                    if (isAutoReading) requestWakeLock();
                });
            }
        } catch (e) {}
    }

    function releaseWakeLock() {
        if (wakeLock !== null) {
            wakeLock.release().then(() => { wakeLock = null; });
        }
    }

    function startBackgroundKeepAlive() {
        requestWakeLock();
        silentKeeper.play().catch(() => {});
        
        if (speechKeepAliveTimer) clearInterval(speechKeepAliveTimer);
        speechKeepAliveTimer = setInterval(() => {
            if (isAutoReading && 'speechSynthesis' in window) {
                if (window.speechSynthesis.speaking && window.speechSynthesis.paused) {
                    window.speechSynthesis.resume();
                }
            }
        }, 2000);
    }

    function stopSpeech() {
        isAutoReading = false;
        releaseWakeLock();
        if (silentKeeper) {
            silentKeeper.pause();
            silentKeeper.currentTime = 0;
        }
        if (speechKeepAliveTimer) {
            clearInterval(speechKeepAliveTimer);
            speechKeepAliveTimer = null;
        }
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
        }
        updateAudioStatusBar("અવાજ બંધ છે.");
    }

    function updateAudioStatusBar(msg) {
        const stat = document.getElementById('audio-live-status');
        if (stat) stat.innerText = msg;
    }

    function speakSingleQuestion(qText, ansText) {
        stopSpeech();
        if (!('speechSynthesis' in window)) {
            alert("તમારા બ્રાઉઝરમાં ઓડિયો સપોર્ટ નથી.");
            return;
        }

        startBackgroundKeepAlive();
        const textToRead = `${qText}.. સાચો જવાબ છે.. ${ansText}`;
        const u = new SpeechSynthesisUtterance(textToRead);
        u.lang = 'gu-IN';
        u.rate = 0.95;

        const voices = window.speechSynthesis.getVoices();
        const guVoice = voices.find(v => v.lang.includes('gu'));
        if (guVoice) u.voice = guVoice;

        u.onend = () => { stopSpeech(); };
        u.onerror = () => { stopSpeech(); };

        window.speechSynthesis.speak(u);
    }

    function startAutoReadFromIndex(startIndex) {
        if (!currentQuestionsList || currentQuestionsList.length === 0) {
            alert("વાંચવા માટે પ્રશ્નો ઉપલબ્ધ નથી.");
            return;
        }

        if (startIndex < 0) startIndex = 0;
        if (startIndex >= currentQuestionsList.length) {
            alert(`કૃપા કરીને ૧ થી ${currentQuestionsList.length} વચ્ચેનો નંબર પસંદ કરો.`);
            return;
        }

        stopSpeech();
        isAutoReading = true;
        currentQIndex = startIndex;
        startBackgroundKeepAlive();

        readNextQuestion();
    }

    function triggerCustomStart() {
        const inputElem = document.getElementById('jump-to-q-input');
        let val = parseInt(inputElem.value);
        if (isNaN(val) || val < 1) val = 1;
        startAutoReadFromIndex(val - 1);
    }

    function resumeOrStartAutoRead() {
        startAutoReadFromIndex(currentQIndex);
    }

    function readNextQuestion() {
        if (!isAutoReading || currentQIndex >= currentQuestionsList.length) {
            stopSpeech();
            updateAudioStatusBar("બધા પ્રશ્નોનું વાચન પૂર્ણ થયું.");
            return;
        }

        const item = currentQuestionsList[currentQIndex];
        const correctAns = item.options[item.answer] || '';
        const textToRead = `પ્રશ્ન ${currentQIndex + 1}.. ${item.q}.. સાચો જવાબ છે.. ${correctAns}`;

        updateAudioStatusBar(`🔊 પ્રશ્ન ${currentQIndex + 1} વંચાઈ રહ્યો છે... (કુલ: ${currentQuestionsList.length})`);
        
        const inputElem = document.getElementById('jump-to-q-input');
        if (inputElem) inputElem.value = currentQIndex + 1;

        const u = new SpeechSynthesisUtterance(textToRead);
        u.lang = 'gu-IN';
        u.rate = 0.95;

        const voices = window.speechSynthesis.getVoices();
        const guVoice = voices.find(v => v.lang.includes('gu'));
        if (guVoice) u.voice = guVoice;

        u.onend = () => {
            if (isAutoReading) {
                currentQIndex++;
                readNextQuestion();
            }
        };

        u.onerror = () => {
            if (isAutoReading) {
                currentQIndex++;
                readNextQuestion();
            }
        };

        window.speechSynthesis.speak(u);
    }

    // ==========================================
    // BACKUP & RESTORE UTILITY FUNCTIONS
    // ==========================================
    function exportFullDatabase() {
        const fullDataStr = localStorage.getItem('htat_custom_db');
        if (!fullDataStr) {
            alert("ડાઉનલોડ કરવા માટે કોઈ ડેટા નથી!");
            return;
        }
        const blob = new Blob([fullDataStr], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `HTAT_Full_Database_Backup_${new Date().toISOString().slice(0,10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        alert("✔ ડેટા બેકઅપ ફાઇલ સફળતાપૂર્વક ડાઉનલોડ થઈ ગઈ છે!");
    }

    function importFullDatabase(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const importedData = JSON.parse(e.target.result);
                if (importedData.part1 && importedData.part2 && importedData.part3) {
                    dbData = importedData;
                    localStorage.setItem('htat_custom_db', JSON.stringify(dbData));
                    updateAdminSubDropdown();
                    alert("✔ અભિનંદન! તમામ પ્રશ્નો અને ડેટા સફળતાપૂર્વક ઇમ્પોર્ટ થઈ ગયા છે!");
                } else {
                    alert("✖ અમાન્ય બેકઅપ ફાઇલ! કૃપા કરીને સાચી HTAT બેકઅપ JSON ફાઇલ પસંદ કરો.");
                }
            } catch (err) {
                alert("✖ ફાઇલ વાંચવામાં ભૂલ આવી! કૃપા કરીને વેલિડ JSON ફાઇલ પસંદ કરો.");
            }
        };
        reader.readAsText(file);
    }

