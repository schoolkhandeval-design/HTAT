    <!-- PART 2 SECTION -->
    <div id="part2-section" class="section-box">
        <button class="action-btn" style="background: #64748b; margin-bottom: 18px;" onclick="stopSpeech(); switchMainTab('home')">🏠 હોમ પેજ પર પાછા જાઓ</button>
        <h2 style="font-weight: 800; font-size: 24px; margin-bottom: 18px;">📖 Part - 2: શૈક્ષણિક કાયદાઓ અને સંચાલન</h2>
        <div id="part2-subjects-container"></div>
    </div>

    <!-- PART 3 SECTION -->
    <div id="part3-section" class="section-box">
        <button class="action-btn" style="background: #64748b; margin-bottom: 18px;" onclick="stopSpeech(); switchMainTab('home')">🏠 હોમ પેજ પર પાછા જાઓ</button>
        <h2 style="font-weight: 800; font-size: 24px; margin-bottom: 18px;">📜 Part - 3: અગાઉ લેવાયેલી HTAT એક્ઝામના પેપરો (રિવિઝન)</h2>
