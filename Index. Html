<div class="container">
    <button class="theme-toggle" onclick="toggleTheme()">🌓 Dark / Light Theme</button>

    <div class="header">
        <div class="brand-logo-box" title="શ્રી સરસ્વતી માતાજી">
            <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=120&auto=format&fit=crop&q=80" alt="Mataji">
            <span style="font-size: 12px; font-weight: 700;">શ્રી સરસ્વતી</span>
        </div>
        <div class="header-title">
            <h2>🙏 જય માતાજી 🙏</h2>
            <h1>HTAT MASTER PREPARATION PORTAL 2026</h1>
